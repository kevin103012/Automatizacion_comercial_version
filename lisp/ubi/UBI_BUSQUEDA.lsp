;; --- FUNCION DE RECUPERACI\\U+00D3N DE MEMORIA DEL DWG ---
(defun UBI_RestoreDWGMemory ( / tmp_code ss_vp i e_vp v_num scale_idx cenpt vp_data existing)
  (setq tmp_code (vlax-ldata-get "ML_SUITE" "TARGET_CODE"))
  (if (and tmp_code (/= tmp_code "")) (setq *UBI_TARGET_CODE* tmp_code))
  
  (setq *UBI_VP_DICT* '())
  (setq ss_vp (ssget "X" '((0 . "VIEWPORT"))))
  (if ss_vp
    (progn
      (setq i 0)
      (while (< i (sslength ss_vp))
        (setq e_vp (ssname ss_vp i))
        (setq v_num (vlax-ldata-get e_vp "ML_VP_NUM"))
        (if v_num
          (progn
            (setq scale_idx (vlax-ldata-get e_vp "DYN_VP_SCALE_IDX"))
            (setq cenpt (vlax-ldata-get e_vp "DYN_VP_CENTER"))
            (setq vp_data (list e_vp cenpt scale_idx))
            (setq existing (assoc v_num *UBI_VP_DICT*))
            (if existing
              (setq *UBI_VP_DICT* (subst (cons v_num (list vp_data)) existing *UBI_VP_DICT*))
              (setq *UBI_VP_DICT* (append *UBI_VP_DICT* (list (cons v_num (list vp_data)))))
            )
          )
        )
        (setq i (1+ i))
      )
      (setq ss_vp nil) (gc)
    )
  )
)

