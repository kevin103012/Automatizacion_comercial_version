(defun UBI_GetUbicacionStyle_BR (scl_str elem / scl_entry tipo mapa)
  ;; BR: selector por *GM_PLANO_TIPO* con fallback UBICACION -> 1000.
  (setq tipo (if (and (boundp (quote *GM_PLANO_TIPO*)) *GM_PLANO_TIPO*) *GM_PLANO_TIPO* "UBICACION"))
  (setq mapa (cond ((= tipo "DIAGNOSTICO") *UBI_STYLE_MAP_DIAGNOSTICO*) ((= tipo "PERIMETRICO") *UBI_STYLE_MAP_PERIMETRICO*) ((= tipo "MATRIZ") *UBI_STYLE_MAP_MATRIZ*) (t *UBI_STYLE_MAP*)))
  (setq scl_entry (cdr (assoc scl_str mapa)))
  (if (not scl_entry) (setq scl_entry (cdr (assoc scl_str *UBI_STYLE_MAP*))))
  (if (not scl_entry) (setq scl_entry (cdr (assoc "1000" mapa))))
  (if (not scl_entry) (setq scl_entry (cdr (assoc "1000" *UBI_STYLE_MAP*))))
  (if scl_entry (assoc elem scl_entry))
)

(defun UBI_GetUbicacionStyle (scl_str elem / scl_entry)
  ;; POR QUE delega en BR: el lote debe formatear segun *GM_PLANO_TIPO*
  ;; (UBICACION/DIAGNOSTICO/PERIMETRICO/MATRIZ). Con UBICACION el mapa es el
  ;; mismo de antes, asi que el comportamiento por defecto no cambia.
  (UBI_GetUbicacionStyle_BR scl_str elem)
)

(defun UBI_GetUbicacionStyleVal (style_entry key default / pair)
  (if (and style_entry (setq pair (assoc key (cdr style_entry)))) (cdr pair) default)
)

