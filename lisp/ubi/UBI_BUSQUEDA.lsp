(defun UBI_GetCodePrefix (str / pos)
  (setq pos (vl-string-position 45 str nil t)) ; Busca el \\U+00FAltimo "-"
  (if pos (substr str 1 pos) str)
)

;; PA-4 (H10) 2026-09-28: str-starts-with se define en LAYOUT_UBICACION.lsp
;; (copia canonica, cargada despues de este archivo y usada por AUTOMATIZACION).
;; Aqui vivia una tercera copia muerta, sin llamadas en este modulo.

(defun UBI_GetHyperlinkString (obj / hlinks cnt i hl match url desc t_hl)
  (setq match nil t_hl (getvar "MILLISECS"))
  (if (not (vl-catch-all-error-p (setq hlinks (vl-catch-all-apply 'vla-get-Hyperlinks (list obj)))))
    (progn
      ;; AUD1: Count e Item con catch (una entidad que muere a mitad del
      ;; escaneo ya no aborta el lote con hlinks vivo).
      (setq cnt (vl-catch-all-apply 'vla-get-Count (list hlinks)) i 0)
      (if (or (vl-catch-all-error-p cnt) (not (numberp cnt))) (setq cnt 0))
      (while (and (< i cnt) (not match))
        (setq hl (vl-catch-all-apply 'vla-Item (list hlinks i)))
        (if (vl-catch-all-error-p hl) (setq hl nil))
        (setq url (if hl (vl-catch-all-apply 'vla-get-URL (list hl)) nil))
        (if (or (vl-catch-all-error-p url) (not url) (= url "#")) (setq url ""))
        (setq desc (vl-catch-all-apply 'vla-get-URLDescription (list hl)))
        (if (or (vl-catch-all-error-p desc) (not desc) (= desc "#")) (setq desc ""))
        (setq url (vl-string-trim " \t\n\r" url) desc (vl-string-trim " \t\n\r" desc))
        (if (/= desc "") (setq match desc) (if (/= url "") (setq match url)))
        ;; OPT1/BZ-OPT1: liberar hl local (el wrapper de obj lo libera su llamador).
        (if (and hl (not (vl-catch-all-error-p hl)))
          (vl-catch-all-apply 'vlax-release-object (list hl))
        )
        (setq hl nil i (1+ i))
      )
      (if (and hlinks (not (vl-catch-all-error-p hlinks)))
        (vl-catch-all-apply 'vlax-release-object (list hlinks))
      )
      (setq hlinks nil)
    )
  )
  ;; OPT5 2026-09-27 (F0): acumulador de costo real de lectura de hipervinculos
  ;; (lo publica UBI_ApplyAutoFormat como tramo HL_MS/HL_N del FORMATO).
  (if (numberp t_hl)
    (progn
      (setq *GM_FMT_HL_MS* (+ *GM_FMT_HL_MS* (max 0 (- (getvar "MILLISECS") t_hl))))
      (setq *GM_FMT_HL_N* (1+ *GM_FMT_HL_N*))))
  match
)

(defun UBI_FindPolygonByCode (target_code / ss i obj vobj hl_str match_ent code_up)
  ;; El codigo chapas el terrenito del mapa :v .
  ;; OPT1: vobj se libera por iteracion para no acumular wrappers en el lote.
  ;; OPT6 (F2): con indice de lote la busqueda es en memoria; sin indice, barrido COM.
  (setq match_ent nil code_up (if (= (type target_code) 'STR) (vl-string-trim " \t\n\r" (strcase target_code)) ""))
  (if (/= code_up "")
    (if (and *UBI_ENT_INDEX_READY* *UBI_POLY_INDEX*)
      (setq match_ent (UBI_IndexFindPolyByCode code_up))
      (progn
      (setq ss (ssget "X" (list (cons 0 "LWPOLYLINE,POLYLINE") (cons 410 "Model"))))
      (if ss
        (progn
          (setq i 0)
          (while (and (< i (sslength ss)) (not match_ent))
            (setq obj (ssname ss i))
            ;; AUD1: creacion con catch; entidad caida = se salta.
            (setq vobj (vl-catch-all-apply 'vlax-ename->vla-object (list obj)))
            (if (vl-catch-all-error-p vobj) (setq vobj nil))
            (setq hl_str (if vobj (UBI_GetHyperlinkString vobj) nil))
            (if (and vobj (not (vl-catch-all-error-p vobj)))
              (vl-catch-all-apply 'vlax-release-object (list vobj))
            )
            (setq vobj nil)
            (if (and hl_str (= (vl-string-trim " \t\n\r" (strcase hl_str)) code_up))
              (setq match_ent obj)
            )
            (setq i (1+ i))
          )
          (setq ss nil) (gc)
        )
      )
      )
    )
  )
  match_ent
)

;; Nombre historico conservado para llamadas existentes dentro de la suite.
(defun UBI_FindPolyByCode (target_code)
  (UBI_FindPolygonByCode target_code)
)

(defun UBI_NormalizeSearchKey (value / result)
  (setq result (if (= (type value) 'STR) (strcase (vl-string-trim " \t\n\r" value)) ""))
  (while (vl-string-search " " result) (setq result (vl-string-subst "" " " result)))
  (while (vl-string-search "." result) (setq result (vl-string-subst "" "." result)))
  (while (vl-string-search "-" result) (setq result (vl-string-subst "" "-" result)))
  result
)

(defun UBI_PointInsideBox (point minpt maxpt)
  (and point minpt maxpt
       (>= (car point) (car minpt)) (<= (car point) (car maxpt))
       (>= (cadr point) (cadr minpt)) (<= (cadr point) (cadr maxpt)))
)

(defun UBI_FindPolygonByReference (reference / target ss_text ss_poly i j txt_ent txt_obj txt_value ins minpt maxpt poly_obj result)
  ;; Fallback para plantillas donde el hipervinculo usa U.C. y no el codigo CSV.
  (setq target (UBI_NormalizeSearchKey reference) result nil)
  (if (/= target "")
    (progn
      (setq ss_text (ssget "X" (list (cons 0 "TEXT,MTEXT") (cons 410 "Model")))
            ss_poly (ssget "X" (list (cons 0 "LWPOLYLINE,POLYLINE") (cons 410 "Model"))))
      ;; Algunas plantillas guardan la U.C. como hipervinculo del poligono.
      ;; OPT6 (F2): con indice de lote la busqueda es en memoria; sin indice,
      ;; se conserva el barrido COM original.
      (if (and *UBI_ENT_INDEX_READY* *UBI_POLY_INDEX*)
        (setq result (UBI_IndexFindPolyByRef target))
        (progn
      (if ss_poly
        (progn
          (setq j 0)
          (while (and (< j (sslength ss_poly)) (not result))
            ;; AUD1: creacion con catch; entidad caida = se salta.
            (setq poly_obj (vl-catch-all-apply 'vlax-ename->vla-object (list (ssname ss_poly j))))
            (if (vl-catch-all-error-p poly_obj) (setq poly_obj nil))
            (if (and poly_obj (= target (UBI_NormalizeSearchKey (UBI_GetHyperlinkString poly_obj))))
              (setq result (ssname ss_poly j))
            )
            ;; OPT1/BZ-OPT1: liberar wrapper por iteracion (lote largo).
            (if (and poly_obj (not (vl-catch-all-error-p poly_obj)))
              (vl-catch-all-apply 'vlax-release-object (list poly_obj))
            )
            (setq poly_obj nil j (1+ j))
          )
        )
      )
        )
      )
      (if (and (not result) ss_text ss_poly)
        (progn
          (setq i 0)
          (while (and (< i (sslength ss_text)) (not result))
            (setq txt_ent (ssname ss_text i))
            ;; AUD1: creacion con catch (txt y poly); entidad caida = se salta.
            (setq txt_obj (vl-catch-all-apply 'vlax-ename->vla-object (list txt_ent)))
            (if (vl-catch-all-error-p txt_obj) (setq txt_obj nil))
            (setq txt_value (if txt_obj (vl-catch-all-apply 'vla-get-TextString (list txt_obj)) nil))
            (if (and (not (vl-catch-all-error-p txt_value)) txt_value
                     (vl-string-search target (UBI_NormalizeSearchKey txt_value)))
              (progn
                (setq ins (vl-catch-all-apply 'vlax-get-property (list txt_obj 'InsertionPoint)))
                (if (not (vl-catch-all-error-p ins))
                  (progn
                    (setq ins (vlax-safearray->list ins) j 0)
                    (while (and (< j (sslength ss_poly)) (not result))
                      (setq poly_obj (vl-catch-all-apply 'vlax-ename->vla-object (list (ssname ss_poly j))))
                      (if (vl-catch-all-error-p poly_obj) (setq poly_obj nil))
                      (if (not (vl-catch-all-error-p (vl-catch-all-apply 'vla-getboundingbox (list poly_obj 'minpt 'maxpt))))
                        (progn
                          (setq minpt (vlax-safearray->list minpt) maxpt (vlax-safearray->list maxpt))
                          (if (UBI_PointInsideBox ins minpt maxpt) (setq result (ssname ss_poly j)))
                        )
                      )
                      ;; OPT1/BZ-OPT1: liberar wrapper de bbox por iteracion.
                      (if (and poly_obj (not (vl-catch-all-error-p poly_obj)))
                        (vl-catch-all-apply 'vlax-release-object (list poly_obj))
                      )
                      (setq poly_obj nil j (1+ j))
                    )
                  )
                )
              )
            )
            ;; OPT1/BZ-OPT1: liberar wrapper de texto por iteracion.
            (if (and txt_obj (not (vl-catch-all-error-p txt_obj)))
              (vl-catch-all-apply 'vlax-release-object (list txt_obj))
            )
            (setq txt_obj nil i (1+ i))
          )
        )
      )
    )
  )
  (setq ss_text nil ss_poly nil txt_obj nil poly_obj nil)
  (gc)
  result
)

(defun UBI_FindPolygonByCodeOrReference (target_code reference / result)
  (setq result (UBI_FindPolygonByCode target_code))
  (if (not result) (setq result (UBI_FindPolygonByReference reference)))
  result
)

;; CHUNK 2026-09-29: el wrapper anonimo de vla-getboundingbox fugaba 3/vcodigo
;; (center/suggest/autoescala). Ahora se crea con catch, se libera siempre y la
;; lectura fallida deja el fallback documentado de cada funcion.
(defun UBI_GetPolygonCenter (poly_ent / minpt maxpt result vla_p)
  (if (and poly_ent (entget poly_ent))
    (progn
      (setq vla_p (vl-catch-all-apply 'vlax-ename->vla-object (list poly_ent)))
      (if (vl-catch-all-error-p vla_p)
        (setq vla_p nil))
      (if vla_p
        (progn
          (setq result (vl-catch-all-apply 'vla-getboundingbox (list vla_p 'minpt 'maxpt)))
          (GM:ReleaseObjectSafe vla_p)
          (if (not (vl-catch-all-error-p result))
            (progn
              (setq minpt (vlax-safearray->list minpt) maxpt (vlax-safearray->list maxpt))
              (list (/ (+ (car minpt) (car maxpt)) 2.0)
                    (/ (+ (cadr minpt) (cadr maxpt)) 2.0)
                    0.0)
            )
          )
        )
      )
    )
  )
)